# ============================================
# Конференции.РФ — конфигурация (session-версия)
# ============================================
# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env
# ============================================

# ---- База данных MySQL ----
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=conferences_db

# ---- Сессии ----
# Секрет для подписи cookie сессии.
# Минимум 32 символа. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change_me_to_very_long_random_string_at_least_32_chars

# Время жизни сессии (в миллисекундах). 4 часа = 14400000
SESSION_MAX_AGE=14400000

# ---- Сервер ----
PORT=3000
NODE_ENV=development

# ---- Cookie (для продакшена) ----
# secure=true требует HTTPS. На localhost должно быть false.
COOKIE_SECURE=false
